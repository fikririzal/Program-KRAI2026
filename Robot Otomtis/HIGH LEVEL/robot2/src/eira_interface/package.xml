<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eira_interface</name>
  <version>0.1.0</version>
  <description>Interface for EIRA 2D field visualization and match configuration</description>
  
  <maintainer email="pwindikurniawan@gmail.com">Paulus Windi Kurniawan | CE 23</maintainer>
  <license>MIT</license>
  
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>eira_msgs</depend>
  
  <!-- <exec_depend>python3-tk</exec_depend> -->
  <exec_depend>python3-pyside6</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>