/**
  * @brief This function handles USB low priority or CAN RX0 interrupts.
  */
void USB_LP_CAN1_RX0_IRQHandler(void)
{
  /* USER CODE BEGIN USB_LP_CAN1_RX0_IRQn 0 */
	uint8_t cksum, sH, sL;
  /* USER CODE END USB_LP_CAN1_RX0_IRQn 0 */
  HAL_CAN_IRQHandler(&hcan);
  /* USER CODE BEGIN USB_LP_CAN1_RX0_IRQn 1 */
	
	HAL_CAN_GetRxMessage(&hcan, CAN_RX_FIFO0,  &myCanRxHeader, CanRxData);
	cksum = CanRxData[0]^CanRxData[1]^CanRxData[2];
	if(cksum==CanRxData[3])
	{		if(CanRxData[0]!=0x80)
			{	SetSudutRoda(((short)CanRxData[1]<<8) + CanRxData[2]);
				CanRxData[1]=0x80;	//-128
				HAL_UART_Transmit(&huart3, CanRxData, 2, 20);	// kirim kecepatan roda pada range -127 s/d 127  
			}
			else
			{	offsetSudutRoda = ((short)CanRxData[1]<<8) + CanRxData[2];
			}	
	}
	else if(cksum==~CanRxData[3])		// menu seting
	{		if(CanRxData[0]==0x1)				// Set KP dan KD
			{	KP = CanRxData[1];
				KD = CanRxData[2];					
			}
			else if(CanRxData[0]==0x2)	// mengirim data sudut ke master
			{	if(CanRxData[1]==3)
				{	sH = sudutRoda>>8;
					sL = sudutRoda&255;
					cksum= RodaCanId&7 ^ sH ^ sL;
					myCanTxHeader.StdId = CanIdMaster;	
					CanTxData[0] = RodaCanId&7; 
					CanTxData[1] = sH;
					CanTxData[2] = sL;
					CanTxData[3] = cksum; 
					HAL_CAN_AddTxMessage(&hcan,&myCanTxHeader,CanTxData,&TxMailBox);
				}	
			}	
	}
  /* USER CODE END USB_LP_CAN1_RX0_IRQn 1 */
}

